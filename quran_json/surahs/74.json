{
  "surahNumber": 74,
  "surahName": "Al-Muddaththir",
  "juzNumber": 29,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "يَا أَيُّهَا الْمُدَّثِّرُ",
      "uzbekReading": "Yaaa ayyuhal muddassir.",
      "russianReading": "Йа аййухал муддассир.",
      "uzbekTranslation": "Ey burkanib yotgan!"
    },
    {
      "ayahNumber": 2,
      "arabic": "قُمْ فَأَنْذِرْ",
      "uzbekReading": "Qum fa anzir.",
      "russianReading": "Кум фаанзир.",
      "uzbekTranslation": "Tur va ogohlantir!"
    },
    {
      "ayahNumber": 3,
      "arabic": "وَرَبَّكَ فَكَبِّرْ",
      "uzbekReading": "Va Robbaka fakabbir.",
      "russianReading": "Уараббака факаббир.",
      "uzbekTranslation": "Va Robbingni ulug'la!"
    },
    {
      "ayahNumber": 4,
      "arabic": "وَثِيَابَكَ فَطَهِّرْ",
      "uzbekReading": "Va siyaabaka fatahhir.",
      "russianReading": "Уасийабака фатаххир.",
      "uzbekTranslation": "Va kiyimingni pokla!"
    },
    {
      "ayahNumber": 5,
      "arabic": "وَالرُّجْزَ فَاهْجُرْ",
      "uzbekReading": "Varrujza fahjur.",
      "russianReading": "Уарружза фахжур.",
      "uzbekTranslation": "Va azob(sababchisi)dan chetlan!"
    },
    {
      "ayahNumber": 6,
      "arabic": "وَلَا تَمْنُنْ تَسْتَكْثِرُ",
      "uzbekReading": "Va laa tamnun tastaksir.",
      "russianReading": "Уала тамнун тастаксир.",
      "uzbekTranslation": "Va ko'p."
    },
    {
      "ayahNumber": 7,
      "arabic": "وَلِرَبِّكَ فَاصْبِرْ",
      "uzbekReading": "Va li Robbika fasbir.",
      "russianReading": "Уалираббика фасбир.",
      "uzbekTranslation": "Va Robbing uchun sabr qil!"
    },
    {
      "ayahNumber": 8,
      "arabic": "فَإِذَا نُقِرَ فِي النَّاقُورِ",
      "uzbekReading": "Fa izaa nuqira fin naaquur.",
      "russianReading": "Фаиза нукира фиин накуур.",
      "uzbekTranslation": "Va qachonki dudga puflansa."
    },
    {
      "ayahNumber": 9,
      "arabic": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ",
      "uzbekReading": "Fazaalika yavma 'iziny yavmun 'asiyr.",
      "russianReading": "Фазалика йаумаизий йаумун 'асиир.",
      "uzbekTranslation": "O'shal kun, qiyin kundir."
    },
    {
      "ayahNumber": 10,
      "arabic": "عَلَى الْكَافِرِينَ غَيْرُ يَسِيرٍ",
      "uzbekReading": "'Alal kaafiriyna g'airu yasiyr.",
      "russianReading": "'Алал кафириина гайру йасиир.",
      "uzbekTranslation": "U kofirlarga oson emasdir."
    },
    {
      "ayahNumber": 11,
      "arabic": "ذَرْنِي وَمَنْ خَلَقْتُ وَحِيدًا",
      "uzbekReading": "Zarniy va man xalaqtu vahiydaa.",
      "russianReading": "Зарнии уаман халакту уахиида.",
      "uzbekTranslation": "Meni, O'zim yakka yaratgan kimsa bidan qo'yib qo'y."
    },
    {
      "ayahNumber": 12,
      "arabic": "وَجَعَلْتُ لَهُ مَالًا مَمْدُودًا",
      "uzbekReading": "Va ja'altu lahuu maalam mamduudaa.",
      "russianReading": "Уажа'алту лаху малам мамдууда.",
      "uzbekTranslation": "Va unga ko'plab molu dunyo."
    },
    {
      "ayahNumber": 13,
      "arabic": "وَبَنِينَ شُهُودًا",
      "uzbekReading": "Va baniyna shuhuudaa.",
      "russianReading": "Уабаниина шухууда.",
      "uzbekTranslation": "Va hoziru nozir farzandlar berib qo'ydim."
    },
    {
      "ayahNumber": 14,
      "arabic": "وَمَهَّدْتُ لَهُ تَمْهِيدًا",
      "uzbekReading": "Va mahhattu lahuu tamhiyda.",
      "russianReading": "Уамаххадтту лаху тамхиида.",
      "uzbekTranslation": "Va unga."
    },
    {
      "ayahNumber": 15,
      "arabic": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
      "uzbekReading": "Summa yat ma'u an aziyd.",
      "russianReading": "Сумма йатма'у ан азиид.",
      "uzbekTranslation": "So'ngra, yana ziyoda qilishimni tama' qiladir."
    },
    {
      "ayahNumber": 16,
      "arabic": "كَلَّا ۖ إِنَّهُ كَانَ لِآيَاتِنَا عَنِيدًا",
      "uzbekReading": "Kallaaa innahuu kaana li Aayaatinaa 'aniydaa.",
      "russianReading": "Калла иннаху кана лиайатина 'аниида.",
      "uzbekTranslation": "Yo'q! Chunki, u Bizning oyatlarimizga sarkash edi."
    },
    {
      "ayahNumber": 17,
      "arabic": "سَأُرْهِقُهُ صَعُودًا",
      "uzbekReading": "Sa urhiquhuu sa'uudaa.",
      "russianReading": "Саурхикуху са'ууда.",
      "uzbekTranslation": "Tezda uni mashaqqatli chiqishla horitarman."
    },
    {
      "ayahNumber": 18,
      "arabic": "إِنَّهُ فَكَّرَ وَقَدَّرَ",
      "uzbekReading": "Innahuu fakkara va qaddar.",
      "russianReading": "Иннаху факкара уакаддар.",
      "uzbekTranslation": "Albatta, u tafakkur qildi va chamalab ko'rdi."
    },
    {
      "ayahNumber": 19,
      "arabic": "فَقُتِلَ كَيْفَ قَدَّرَ",
      "uzbekReading": "Faqutila kayfa qaddar.",
      "russianReading": "Факутила кайфа каддар.",
      "uzbekTranslation": "La'nat bo'lsin unga, qandoq ham chamalab ko'rdi!"
    },
    {
      "ayahNumber": 20,
      "arabic": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
      "uzbekReading": "Summa qutila kaifa qaddar.",
      "russianReading": "Сумма кутила кайфа каддар.",
      "uzbekTranslation": "So'ngra yana la'nat bo'lsin unga, qandoq ham chamalab ko'rdi."
    },
    {
      "ayahNumber": 21,
      "arabic": "ثُمَّ نَظَرَ",
      "uzbekReading": "Summa nazar.",
      "russianReading": "Сумма назар.",
      "uzbekTranslation": "So'ngra nazar soldi."
    },
    {
      "ayahNumber": 22,
      "arabic": "ثُمَّ عَبَسَ وَبَسَرَ",
      "uzbekReading": "Summa 'abasa va basar.",
      "russianReading": "Сумма 'абаса уабасар.",
      "uzbekTranslation": "So'ngra yuzini burishtirdi va qavog'ini soldi."
    },
    {
      "ayahNumber": 23,
      "arabic": "ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ",
      "uzbekReading": "Summaa adbara vastakbar.",
      "russianReading": "Сумма адбара уастакбар.",
      "uzbekTranslation": "So'ngra yuz o'girdi va takabburlik qildi."
    },
    {
      "ayahNumber": 24,
      "arabic": "فَقَالَ إِنْ هَٰذَا إِلَّا سِحْرٌ يُؤْثَرُ",
      "uzbekReading": "Faqaala in haazaaa illaa sihruny yu'sar.",
      "russianReading": "Факала ин хаза илла сихрун йу'сар.",
      "uzbekTranslation": "Bas, bu asar qolgan sehrdan o'zga hech narsa emas."
    },
    {
      "ayahNumber": 25,
      "arabic": "إِنْ هَٰذَا إِلَّا قَوْلُ الْبَشَرِ",
      "uzbekReading": "In haazaaa illaa qavlul bashar.",
      "russianReading": "Ин хаза илла каулул башар.",
      "uzbekTranslation": "Bu bashar so'zidan o'zga hech narsa emas, dedi."
    },
    {
      "ayahNumber": 26,
      "arabic": "سَأُصْلِيهِ سَقَرَ",
      "uzbekReading": "Sa usliyhi saqar.",
      "russianReading": "Сауслиихи сакар.",
      "uzbekTranslation": "Tezda uni saqar (do'zaxi)ga kiritaman."
    },
    {
      "ayahNumber": 27,
      "arabic": "وَمَا أَدْرَاكَ مَا سَقَرُ",
      "uzbekReading": "Va maaa adraaka maa saqar.",
      "russianReading": "Уама адрака ма сакар.",
      "uzbekTranslation": "Va saqar nimaligini senga nima bildirdi?"
    },
    {
      "ayahNumber": 28,
      "arabic": "لَا تُبْقِي وَلَا تَذَرُ",
      "uzbekReading": "Laa tubqiy va laa tazar.",
      "russianReading": "Ла тубкии уала тазар.",
      "uzbekTranslation": "U (saqar) boqiy qoldirmas va tark ham qilmas."
    },
    {
      "ayahNumber": 29,
      "arabic": "لَوَّاحَةٌ لِلْبَشَرِ",
      "uzbekReading": "Lavvaahatul lilbashar.",
      "russianReading": "Лаууахатул лилбашар.",
      "uzbekTranslation": "U terini ko'p kuydiruvchidir."
    },
    {
      "ayahNumber": 30,
      "arabic": "عَلَيْهَا تِسْعَةَ عَشَرَ",
      "uzbekReading": "'Alaihaa tis'ata 'ashar.",
      "russianReading": "'Алайха тис'ата 'ашар.",
      "uzbekTranslation": "Uning ustida o'n to'qqizta (farishta) bordir."
    },
    {
      "ayahNumber": 31,
      "arabic": "وَمَا جَعَلْنَا أَصْحَابَ النَّارِ إِلَّا مَلَائِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِلَّذِينَ كَفَرُوا لِيَسْتَيْقِنَ الَّذِينَ أُوتُوا الْكِتَابَ وَيَزْدَادَ الَّذِينَ آمَنُوا إِيمَانًا ۙ وَلَا يَرْتَابَ الَّذِينَ أُوتُوا الْكِتَابَ وَالْمُؤْمِنُونَ ۙ وَلِيَقُولَ الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْكَافِرُونَ مَاذَا أَرَادَ اللَّهُ بِهَٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ اللَّهُ مَنْ يَشَاءُ وَيَهْدِي مَنْ يَشَاءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِيَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
      "uzbekReading": "Va maaja'alnaaa As-haaban naari illaa malaaa 'ikatanv va maa ja'alnaa 'iddatahum illaa fitnatal lillaziyna kafaruu liyastaiqinal laziyna uutul kitaaba va yazdaadal laziyna aamanuu iymaananv va laa yartaabal laziyna uutul kitaaba valmu'minuuna va liyaquulal laziyna fiy quluu bihim maradunv valkaafiruuna maazaaa araadal laahu bihaazaa masalaa; kazaalika yudillul laahu mai yashaaa'u va yahdiy mai yashaaa'; va maa ya'lamu junuuda Robbika illaa huu; va maa hiya illaa zikraa lil bashar.",
      "russianReading": "Уама жа'ална асхабан нари илла малаикатан уама жа'ална 'иддатахум илла фитнатал лиллазиина кафаруу лийастайкинал лазиина уутуул китаба уайаздадал лазиина амануу ииманан уала йартабал лазиина уутуул китаба уалму'минууна уалийакуулал лазиина фии кулуубихим марадуу уалкафирууна маза арадаллаху бихаза масала казалика йудиллуллаху май йашау уайахдии май йаша уама йа'ламу жунууда раббика илла хуу уама хийа илла зикра лилбашар.",
      "uzbekTranslation": "Do'zax sohiblarini farishtalardan qilganimiz va ularning adadi ham faqat kofirlarni sanash uchundir. Kitob berilganlar ishonch hosil qilishlari uchundir. Va iymonlilarning iymoni ziyoda bo'lishi uchundir. Kitob berilganlar va mo'minlar shak-shubha qilmasliklari uchundir va qalblarida kasali bor."
    },
    {
      "ayahNumber": 32,
      "arabic": "كَلَّا وَالْقَمَرِ",
      "uzbekReading": "Kallaa valqamar.",
      "russianReading": "Калла уалкамар.",
      "uzbekTranslation": "Yo'q! Oy bilan qasam."
    },
    {
      "ayahNumber": 33,
      "arabic": "وَاللَّيْلِ إِذْ أَدْبَرَ",
      "uzbekReading": "Vallaili id adbar.",
      "russianReading": "Уаллайли из адбар.",
      "uzbekTranslation": "Va chekinayotgan tun bilan qasam."
    },
    {
      "ayahNumber": 34,
      "arabic": "وَالصُّبْحِ إِذَا أَسْفَرَ",
      "uzbekReading": "Vassub hi izaaa asfar.",
      "russianReading": "Уассубхи иза асфар.",
      "uzbekTranslation": "Va yorishayotgan tong bilan qasam."
    },
    {
      "ayahNumber": 35,
      "arabic": "إِنَّهَا لَإِحْدَى الْكُبَرِ",
      "uzbekReading": "Innahaa la ihdal kubar.",
      "russianReading": "Иннаха лаихдал кубар.",
      "uzbekTranslation": "Albatta u."
    },
    {
      "ayahNumber": 36,
      "arabic": "نَذِيرًا لِلْبَشَرِ",
      "uzbekReading": "Naziyral lilbashar.",
      "russianReading": "Назиирал лилбашар.",
      "uzbekTranslation": "Bashariyat uchun ogohlantiruvchidir."
    },
    {
      "ayahNumber": 37,
      "arabic": "لِمَنْ شَاءَ مِنْكُمْ أَنْ يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
      "uzbekReading": "Liman shaaa'a minkum any yataqaddama av yata axxar.",
      "russianReading": "Лиман шаа минкум ай йатакаддама ау йатааххар.",
      "uzbekTranslation": "Sizlardan peshqadam bo'lishni yoki ortda qolishni xohlayotgan kimsalar uchun hamdir."
    },
    {
      "ayahNumber": 38,
      "arabic": "كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ",
      "uzbekReading": "Kullu nafsim bim kasabat rahiynah.",
      "russianReading": "Куллу нафсин бима касабат рахиина.",
      "uzbekTranslation": "Har bir shaxs o'z kasbining garovidir."
    },
    {
      "ayahNumber": 39,
      "arabic": "إِلَّا أَصْحَابَ الْيَمِينِ",
      "uzbekReading": "Illaaa as haabal yamiyn.",
      "russianReading": "Илла асхабал йамиин.",
      "uzbekTranslation": "Magar o'ng taraf sohiblari mustasnodir."
    },
    {
      "ayahNumber": 40,
      "arabic": "فِي جَنَّاتٍ يَتَسَاءَلُونَ",
      "uzbekReading": "Fiy jannaatiny yata saaa'aluun.",
      "russianReading": "Фии жаннатий йатасаалуун.",
      "uzbekTranslation": "Ular jannatlarda so'rarlar."
    },
    {
      "ayahNumber": 41,
      "arabic": "عَنِ الْمُجْرِمِينَ",
      "uzbekReading": "'Anil mujrimiyn.",
      "russianReading": "'Анил мужримиин.",
      "uzbekTranslation": "Gunohkorlardan."
    },
    {
      "ayahNumber": 42,
      "arabic": "مَا سَلَكَكُمْ فِي سَقَرَ",
      "uzbekReading": "Maa salakakum fiy saqar.",
      "russianReading": "Ма салакакум фии сакар.",
      "uzbekTranslation": "Sizlarni do'zaxga nima kiritdi?"
    },
    {
      "ayahNumber": 43,
      "arabic": "قَالُوا لَمْ نَكُ مِنَ الْمُصَلِّينَ",
      "uzbekReading": "Qaaluu lam naku minal musalliyn.",
      "russianReading": "Калуу лам наку минал мусаллиин.",
      "uzbekTranslation": "Ular: «Namoz o'qiydiganlardan bo'lmagan edik."
    },
    {
      "ayahNumber": 44,
      "arabic": "وَلَمْ نَكُ نُطْعِمُ الْمِسْكِينَ",
      "uzbekReading": "Va lam naku nut'imul miskiyn.",
      "russianReading": "Уалам наку нут'имул мискиин.",
      "uzbekTranslation": "Va miskinlarga taom bermagan edik."
    },
    {
      "ayahNumber": 45,
      "arabic": "وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ",
      "uzbekReading": "Va kunnaa naxuudu ma'al xaaa'idiyn.",
      "russianReading": "Уакунна нахууду ма'ал хаидиин.",
      "uzbekTranslation": "Va botilga shung'uvchilar bilan birga sho'ng'ir edik."
    },
    {
      "ayahNumber": 46,
      "arabic": "وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّينِ",
      "uzbekReading": "Va kunnaa nukazzibu bi yavmid Diyn.",
      "russianReading": "Уакунна нуказзибу бийаумид диин.",
      "uzbekTranslation": "Va qiyomat kuni yolg'onga chiqargan edik."
    },
    {
      "ayahNumber": 47,
      "arabic": "حَتَّىٰ أَتَانَا الْيَقِينُ",
      "uzbekReading": "Hattaaa ataanal yaqiyn.",
      "russianReading": "Хатта атанал йакиин.",
      "uzbekTranslation": "Toki bizga o'lim kelgunicha», derlar."
    },
    {
      "ayahNumber": 48,
      "arabic": "فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ",
      "uzbekReading": "Famaa tanfa'uhum shafaa'atush shaafi'iyn.",
      "russianReading": "Фама танфа'ухум шафа'атуш шафи'иин.",
      "uzbekTranslation": "Bas, ularga shafoatchilarning shafoati manfaat bermas."
    },
    {
      "ayahNumber": 49,
      "arabic": "فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِينَ",
      "uzbekReading": "Famaa lahum 'anittazkirati mu'ridiyn.",
      "russianReading": "Фама лахум 'анит тазкирати му'ридиин.",
      "uzbekTranslation": "Ularga ne bo'ldiki, eslatmadan yuz o'rirurlar?!"
    },
    {
      "ayahNumber": 50,
      "arabic": "كَأَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌ",
      "uzbekReading": "Ka annahum humurum mustanfirah.",
      "russianReading": "Кааннахум хумурум мустанфира.",
      "uzbekTranslation": "Xuddi qattiq qo'rqqan eshaklar."
    },
    {
      "ayahNumber": 51,
      "arabic": "فَرَّتْ مِنْ قَسْوَرَةٍ",
      "uzbekReading": "Farrat min qasvarah.",
      "russianReading": "Фаррат мин касуара.",
      "uzbekTranslation": "Arslondan qochgani kabi."
    },
    {
      "ayahNumber": 52,
      "arabic": "بَلْ يُرِيدُ كُلُّ امْرِئٍ مِنْهُمْ أَنْ يُؤْتَىٰ صُحُفًا مُنَشَّرَةً",
      "uzbekReading": "Bal yuriydu kullum ri'im minhum any yu'taa suhufam munashsharah.",
      "russianReading": "Бал йурииду куллу мриим минхум ай йу'та сухуфам мунашшара.",
      "uzbekTranslation": "Balki ulardan har biri o'ziga nashr qilingan sahifalar berilishini iroda qiladir."
    },
    {
      "ayahNumber": 53,
      "arabic": "كَلَّا ۖ بَلْ لَا يَخَافُونَ الْآخِرَةَ",
      "uzbekReading": "Kallaa bal laa yaxaafuunal aaxirah.",
      "russianReading": "Калла бал ла йахафуунал ахира.",
      "uzbekTranslation": "Yo'q! Balki ular oxiratdan qo'rqmaslar."
    },
