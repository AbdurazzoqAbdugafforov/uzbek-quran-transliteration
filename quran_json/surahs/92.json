{
  "surahNumber": 92,
  "surahName": "Al-Lail",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "وَاللَّيْلِ إِذَا يَغْشَىٰ",
      "uzbekReading": "Vallaili izaa yag'shaa.",
      "russianReading": "Уаллайли иза йагша.",
      "uzbekTranslation": "Tunning qoplab kelayotgan payti bilan qasam."
    },
    {
      "ayahNumber": 2,
      "arabic": "وَالنَّهَارِ إِذَا تَجَلَّىٰ",
      "uzbekReading": "Vannahaari izaa tajalla.",
      "russianReading": "Уаннахари иза тажалла.",
      "uzbekTranslation": "Nahorning tajalli payti bilan qasam."
    },
    {
      "ayahNumber": 3,
      "arabic": "وَمَا خَلَقَ الذَّكَرَ وَالْأُنْثَىٰ",
      "uzbekReading": "Va maa xalaqaz zakara val unsaa.",
      "russianReading": "Уама халаказ закара уалунса.",
      "uzbekTranslation": "Erkak va urg'ochining yaratilishi bilan qasam."
    },
    {
      "ayahNumber": 4,
      "arabic": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "uzbekReading": "Inna sa'yakum lashattaa.",
      "russianReading": "Инна са'йакум лашатта.",
      "uzbekTranslation": "Albatta, sizlarning ishlaringiz turlichadur."
    },
    {
      "ayahNumber": 5,
      "arabic": "فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ",
      "uzbekReading": "Fa ammaa man a'taa vattaqaa.",
      "russianReading": "Фаамма ман а'та уаттака.",
      "uzbekTranslation": "Ammo kimki (ato) bersa va taqvo qilsa."
    },
    {
      "ayahNumber": 6,
      "arabic": "وَصَدَّقَ بِالْحُسْنَىٰ",
      "uzbekReading": "Va saddaqa bil husnaa.",
      "russianReading": "Уасаддака билхусна.",
      "uzbekTranslation": "Va go'zal(so'z)ni tasdiq qilsa."
    },
    {
      "ayahNumber": 7,
      "arabic": "فَسَنُيَسِّرُهُ لِلْيُسْرَىٰ",
      "uzbekReading": "Fasanu yassiruhuu lilyusraa.",
      "russianReading": "Фасануйассируху лилйусра.",
      "uzbekTranslation": "Bas, Biz uni osonga muyassar qilamiz."
    },
    {
      "ayahNumber": 8,
      "arabic": "وَأَمَّا مَنْ بَخِلَ وَاسْتَغْنَىٰ",
      "uzbekReading": "Va ammaa mam baxila vastag'naa.",
      "russianReading": "Уаамма ман бахила уастагна.",
      "uzbekTranslation": "Ammo kimki baxillik va istig'no qilsa."
    },
    {
      "ayahNumber": 9,
      "arabic": "وَكَذَّبَ بِالْحُسْنَىٰ",
      "uzbekReading": "Va kazzaba bil husnaa.",
      "russianReading": "Уаказзаба билхусна.",
      "uzbekTranslation": "Va go'zal(so'z)ni yolg'onga chiqarsa."
    },
    {
      "ayahNumber": 10,
      "arabic": "فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ",
      "uzbekReading": "Fasanu yassiruhuu lil'usraa.",
      "russianReading": "Фасануйассируху лил'усра.",
      "uzbekTranslation": "Bas, Biz uni qiyinga muyassar qilamiz."
    },
    {
      "ayahNumber": 11,
      "arabic": "وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّىٰ",
      "uzbekReading": "Va maa yug'niy 'anhu maaluhuuo izaa taraddaa.",
      "russianReading": "Уама йугнии 'анху малуху иза тарадда.",
      "uzbekTranslation": "U qulagan vaqtda unga mol-mulki foyda bermas."
    },
    {
      "ayahNumber": 12,
      "arabic": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "uzbekReading": "Inna 'alainaa lal hudaa.",
      "russianReading": "Инна 'алайна лалхуда.",
      "uzbekTranslation": "Albatta, hidoyatga boshlash Bizning zimmamizdadir."
    },
    {
      "ayahNumber": 13,
      "arabic": "وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَىٰ",
      "uzbekReading": "Va inna lanaa lal Aaxirata val uulaa.",
      "russianReading": "Уаинна лана лалахирата уалуула.",
      "uzbekTranslation": "Albatta, ham oxirat va ham bu dunyo Biznikidir."
    },
    {
      "ayahNumber": 14,
      "arabic": "فَأَنْذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "uzbekReading": "Fa anzartukum naaran talazzaa.",
      "russianReading": "Фаанзартукум наран талазза.",
      "uzbekTranslation": "Bas, Men sizlarni."
    },
    {
      "ayahNumber": 15,
      "arabic": "لَا يَصْلَاهَا إِلَّا الْأَشْقَى",
      "uzbekReading": "Laa yaslaahaaa illal ashqaa.",
      "russianReading": "Ла йаслаха иллал ашка.",
      "uzbekTranslation": "U(o't)ga badbaxtdan boshqa hech kim kirmas."
    },
    {
      "ayahNumber": 16,
      "arabic": "الَّذِي كَذَّبَ وَتَوَلَّىٰ",
      "uzbekReading": "Allaziy kazzaba va tavallaa.",
      "russianReading": "Аллазии каззаба уатауалла.",
      "uzbekTranslation": "O'sha yolg'onga chiqargan va yuz o'girgan edi."
    },
    {
      "ayahNumber": 17,
      "arabic": "وَسَيُجَنَّبُهَا الْأَتْقَى",
      "uzbekReading": "Va sa yujannnabuhal atqaa.",
      "russianReading": "Уасайужаннабухал атка.",
      "uzbekTranslation": "Va albatta, undan taqvodor banda chetda qoladi."
    },
    {
      "ayahNumber": 18,
      "arabic": "الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّىٰ",
      "uzbekReading": "Allaziy yu'tiy maalahuu yatazakkaa.",
      "russianReading": "Аллазии йу'тии малаху йатазакка.",
      "uzbekTranslation": "U boyligini sarflaydi va o'zini poklaydi."
    },
    {
      "ayahNumber": 19,
      "arabic": "وَمَا لِأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَىٰ",
      "uzbekReading": "Va maa li ahadin 'indahuu min ni'matin tujzaaa.",
      "russianReading": "Уама лиахадин 'индаху мин ни'матин тужза.",
      "uzbekTranslation": "Unda biror kishining qaytarilishi lozim yaxshiligi yo'q edi."
    },
    {
      "ayahNumber": 20,
      "arabic": "إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَىٰ",
      "uzbekReading": "Illab tig'aaa'a vajhi Robbihil a 'laa.",
      "russianReading": "Илла бтигаа уажхи раббихил а'ла.",
      "uzbekTranslation": "Faqatgina oliy maqom Robbisining roziligini so'rab qiladi."
    },
    {
      "ayahNumber": 21,
      "arabic": "وَلَسَوْفَ يَرْضَىٰ",
      "uzbekReading": "Va lasavfa yardaa.",
      "russianReading": "Уаласауфа йарда.",
      "uzbekTranslation": "Va u albatta tezda rozi bo'ladi."
    }
  ]
}
