{
  "surahNumber": 79,
  "surahName": "An-Naazi'aat",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "وَالنَّازِعَاتِ غَرْقًا",
      "uzbekReading": "Van naazi 'aati g'arqa.",
      "uzbekTranslation": "Shiddat bilan."
    },
    {
      "ayahNumber": 2,
      "arabic": "وَالنَّاشِطَاتِ نَشْطًا",
      "uzbekReading": "Van naa shi taati nashta.",
      "uzbekTranslation": "Yumshoqlik bilan."
    },
    {
      "ayahNumber": 3,
      "arabic": "وَالسَّابِحَاتِ سَبْحًا",
      "uzbekReading": "Vass saabi-haati sabha.",
      "uzbekTranslation": "Suzib yuruvchi (farishta)lar bilan qasam."
    },
    {
      "ayahNumber": 4,
      "arabic": "فَالسَّابِقَاتِ سَبْقًا",
      "uzbekReading": "Fass saabi qaati sabqa.",
      "uzbekTranslation": "O'zishda musobaqa qiluvchi (farishta)lar bilan qasam."
    },
    {
      "ayahNumber": 5,
      "arabic": "فَالْمُدَبِّرَاتِ أَمْرًا",
      "uzbekReading": "Fal mu dab-bi raati amra.",
      "uzbekTranslation": "Amrning tadbirini qiluvchi (farishta)lar bilan qasam."
    },
    {
      "ayahNumber": 6,
      "arabic": "يَوْمَ تَرْجُفُ الرَّاجِفَةُ",
      "uzbekReading": "Yavma tarjufur raajifa.",
      "uzbekTranslation": "Iztirobga tushuvchi iztirobga tushgan kunda."
    },
    {
      "ayahNumber": 7,
      "arabic": "تَتْبَعُهَا الرَّادِفَةُ",
      "uzbekReading": "Tatba'u har raadifa.",
      "uzbekTranslation": "Unga ergashuvchi ergashar."
    },
    {
      "ayahNumber": 8,
      "arabic": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
      "uzbekReading": "Quluubuny-yau maaiziw-vaaji-fa.",
      "uzbekTranslation": "O'sha kunda qalblar xavfga to'lar."
    },
    {
      "ayahNumber": 9,
      "arabic": "أَبْصَارُهَا خَاشِعَةٌ",
      "uzbekReading": "Absaa ruhaa xashi'ah.",
      "uzbekTranslation": "Ularning ko'zlari qo'rqinchga to'lar."
    },
    {
      "ayahNumber": 10,
      "arabic": "يَقُولُونَ أَإِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِ",
      "uzbekReading": "Ya quu luuna a-inna lamar duu duuna fil haafirah.",
      "uzbekTranslation": "Ular: «Biz ortga qaytarilamizmi?"
    },
    {
      "ayahNumber": 11,
      "arabic": "أَإِذَا كُنَّا عِظَامًا نَخِرَةً",
      "uzbekReading": "Aizaa kunna 'izaa man-naxirah.",
      "uzbekTranslation": "Chirigan suyak bo'lganimizdan keyin ham-a?"
    },
    {
      "ayahNumber": 12,
      "arabic": "قَالُوا تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "uzbekReading": "Qaalu tilka izan karratun xaasirah.",
      "uzbekTranslation": "Agar shundoq bo'lsa, bu hasratiy qaytish-ku?» derlar."
    },
    {
      "ayahNumber": 13,
      "arabic": "فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ",
      "uzbekReading": "Fa inna ma hiya zajratuw-vaahida.",
      "uzbekTranslation": "Albatta, u."
    },
    {
      "ayahNumber": 14,
      "arabic": "فَإِذَا هُمْ بِالسَّاهِرَةِ",
      "uzbekReading": "Faizaa hum biss saahirah.",
      "uzbekTranslation": "Ko'ribsizki, ular qiyomat maydonida turibdi-da."
    },
    {
      "ayahNumber": 15,
      "arabic": "هَلْ أَتَاكَ حَدِيثُ مُوسَىٰ",
      "uzbekReading": "Hal ataaka hadiysu Musaa.",
      "uzbekTranslation": "Senga Musoning xabari keldimi?"
    },
    {
      "ayahNumber": 16,
      "arabic": "إِذْ نَادَاهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًى",
      "uzbekReading": "Iz nadaahu Robbuhu bil vaadil-muqad dasi tuva.",
      "uzbekTranslation": "Qachonki Robbisi unga muqaddas Tuva vodiysida nido qildi:."
    },
    {
      "ayahNumber": 17,
      "arabic": "اذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُ طَغَىٰ",
      "uzbekReading": "Izhab ilaa fir'auna innahu tag'aa.",
      "uzbekTranslation": "«Fir'avn huzuriga bor, albatta u tug'yonga ketdi."
    },
    {
      "ayahNumber": 18,
      "arabic": "فَقُلْ هَلْ لَكَ إِلَىٰ أَنْ تَزَكَّىٰ",
      "uzbekReading": "Faqul hal laka ilaa-an tazakka.",
      "uzbekTranslation": "Bas unga ayt: «Senda poklanishga (rag'bat) bormi?"
    },
    {
      "ayahNumber": 19,
      "arabic": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "uzbekReading": "Va ahdi yaka ila Robbika fatax sha.",
      "uzbekTranslation": "Va seni Robbingga hidoyat qilsam, shoyadki (Undan) qo'rqsang», deb»"
    },
    {
      "ayahNumber": 20,
      "arabic": "فَأَرَاهُ الْآيَةَ الْكُبْرَىٰ",
      "uzbekReading": "Fa araahul-aayatal kubra.",
      "uzbekTranslation": "Va unga ulkan alomatni ko'rsatdi."
    },
    {
      "ayahNumber": 21,
      "arabic": "فَكَذَّبَ وَعَصَىٰ",
      "uzbekReading": "Fa kazzaba va asaa.",
      "uzbekTranslation": "Ul uni yolg'onga chiqardi va osiy bo'ldi."
    },
    {
      "ayahNumber": 22,
      "arabic": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "uzbekReading": "Summa adbara yas'aa.",
      "uzbekTranslation": "So'ng ortiga o'girilib tezlab ketdi¬."
    },
    {
      "ayahNumber": 23,
      "arabic": "فَحَشَرَ فَنَادَىٰ",
      "uzbekReading": "Fa hashara fanada.",
      "uzbekTranslation": "Keyin (odamlarni) to'plab nido qildi."
    },
    {
      "ayahNumber": 24,
      "arabic": "فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَىٰ",
      "uzbekReading": "Faqala ana Robbu kumul-a'laa.",
      "uzbekTranslation": "Va, men sizlarning eng oliy Robbingizman, dedi."
    },
    {
      "ayahNumber": 25,
      "arabic": "فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَىٰ",
      "uzbekReading": "Fa-axa zahul laahu nakalal aaxirati val-uula.",
      "uzbekTranslation": "Bas Alloh uni avvalgi va oxirgi gunohlari uchun azobga oldi."
    },
    {
      "ayahNumber": 26,
      "arabic": "إِنَّ فِي ذَٰلِكَ لَعِبْرَةً لِمَنْ يَخْشَىٰ",
      "uzbekReading": "Inna fiy zaalika la'ibratal limaiy-yaksha.",
      "uzbekTranslation": "Albatta, bunda qo'rqadiganlar uchun ibrat bordir."
    },
    {
      "ayahNumber": 27,
      "arabic": "أَأَنْتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاءُ ۚ بَنَاهَا",
      "uzbekReading": "A-antum a shaddu xalqan amis samaa-u banaaha.",
      "uzbekTranslation": "Sizlarni yaratish qiyinmi yoki U zot bino qilgan osmonnimi?"
    },
    {
      "ayahNumber": 28,
      "arabic": "رَفَعَ سَمْكَهَا فَسَوَّاهَا",
      "uzbekReading": "Raf'a sam kaha fasaw vaaha.",
      "uzbekTranslation": "Uning shiftini yuqori ko'tardi va bekamu ko'st, mustahkam qilib qo'ydi."
    },
    {
      "ayahNumber": 29,
      "arabic": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَاهَا",
      "uzbekReading": "Va ag'tasha lailaha va axraja duhaaha.",
      "uzbekTranslation": "Kechasini qorong'u va kunduzini yorug' qildi."
    },
    {
      "ayahNumber": 30,
      "arabic": "وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَاهَا",
      "uzbekReading": "Val arda b'ada zaalika dahaaha.",
      "uzbekTranslation": "Va undan so'ng yerni tuxum shaklida qildi."
    },
    {
      "ayahNumber": 31,
      "arabic": "أَخْرَجَ مِنْهَا مَاءَهَا وَمَرْعَاهَا",
      "uzbekReading": "Axraja minha maa-aha va mar 'aaha.",
      "uzbekTranslation": "Undan suvni, o't-o'lanlarni chiqardi."
    },
    {
      "ayahNumber": 32,
      "arabic": "وَالْجِبَالَ أَرْسَاهَا",
      "uzbekReading": "Val jibala arsaaha.",
      "uzbekTranslation": "Va tog'larni sobit qildi."
    },
    {
      "ayahNumber": 33,
      "arabic": "مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ",
      "uzbekReading": "Mataa'al lakum vali an 'aamikum.",
      "uzbekTranslation": "Sizlarga va chorvalaringizga manfaat bo'lsin uchun."
    },
    {
      "ayahNumber": 34,
      "arabic": "فَإِذَا جَاءَتِ الطَّامَّةُ الْكُبْرَىٰ",
      "uzbekReading": "Fa-izaa jaaa'atit taaam matul kubraa.",
      "uzbekTranslation": "Vaqtiki katta g'olib (qiyomat) kelsa."
    },
    {
      "ayahNumber": 35,
      "arabic": "يَوْمَ يَتَذَكَّرُ الْإِنْسَانُ مَا سَعَىٰ",
      "uzbekReading": "Yauma Yata zakkarul insaanu ma sa'aa.",
      "uzbekTranslation": "U kuni inson qilgan ishlarini eslaydir."
    },
    {
      "ayahNumber": 36,
      "arabic": "وَبُرِّزَتِ الْجَحِيمُ لِمَنْ يَرَىٰ",
      "uzbekReading": "Va burrizatil-jahiymu limany-yaraa.",
      "uzbekTranslation": "Va jahannam ko'radiganlarga zohir qilinadir."
    },
    {
      "ayahNumber": 37,
      "arabic": "فَأَمَّا مَنْ طَغَىٰ",
      "uzbekReading": "Fa ammaa man tag'aa.",
      "uzbekTranslation": "Ammo kimiki tug'yonga ketib, haddidan oshgan bo'lsa."
    },
    {
      "ayahNumber": 38,
      "arabic": "وَآثَرَ الْحَيَاةَ الدُّنْيَا",
      "uzbekReading": "Va aasaral hayaatad dunyaa.",
      "uzbekTranslation": "Va bu dunyo hayotini ustun qo'ygan bo'lsa,."
    },
    {
      "ayahNumber": 39,
      "arabic": "فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَىٰ",
      "uzbekReading": "Fa innal jahiyma hiyal maavaa.",
      "uzbekTranslation": "Bas, albatta, Jahiym o'rin bo'ladir."
    },
    {
      "ayahNumber": 40,
      "arabic": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَىٰ",
      "uzbekReading": "Va ammaa man xaafa maqaama Robbihiy va nahan nafsa 'anil havaa.",
      "uzbekTranslation": "Va, ammo kim Robbisining maqomidan qo'rqqan va o'z nafsini havolanib ketishidan qaytargan bo'lsa."
    },
    {
      "ayahNumber": 41,
      "arabic": "فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ",
      "uzbekReading": "Fa innal jannata hiyal maavaa.",
      "uzbekTranslation": "Bas, albatta, jannat o'rin bo'ladir."
    },
    {
      "ayahNumber": 42,
      "arabic": "يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا",
      "uzbekReading": "Yas'aluunaka 'anis saa'ati ayyaana mursaahaa.",
      "uzbekTranslation": "Sendan, qiyomat qachon bo'lur? deb so'rarlar."
    },
    {
      "ayahNumber": 43,
      "arabic": "فِيمَ أَنْتَ مِنْ ذِكْرَاهَا",
      "uzbekReading": "Fiyma anta min zikraahaa.",
      "uzbekTranslation": "Uning zikrini sen qandoq bilarding."
    },
    {
      "ayahNumber": 44,
      "arabic": "إِلَىٰ رَبِّكَ مُنْتَهَاهَا",
      "uzbekReading": "Ilaa Robbika muntahaa haa.",
      "uzbekTranslation": "Uning intihosi Robbingga xosdir."
    },
    {
      "ayahNumber": 45,
      "arabic": "إِنَّمَا أَنْتَ مُنْذِرُ مَنْ يَخْشَاهَا",
      "uzbekReading": "Innamaaa anta munziru maiy yakshaahaa.",
      "uzbekTranslation": "Albatta sen un."
    },
    {
      "ayahNumber": 46,
      "arabic": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوا إِلَّا عَشِيَّةً أَوْ ضُحَاهَا",
      "uzbekReading": "Ka annahum Yavma yaravnahaa lam yalbasuuo illaa 'ashiyyatan aw duhaahaa.",
      "uzbekTranslation": "Uni ko'rgan kunlari xuddi bu dunyoda bir kecha yoki kunduzdan boshqa turmaganga o'xsharlar."
    }
  ]
}