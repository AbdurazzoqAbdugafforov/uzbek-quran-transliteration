    {
      "ayahNumber": 4,
      "arabic": "وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ",
      "uzbekReading": "Va laa ana 'abidum maa 'abattum.",
      "uzbekTranslation": "Va men siz ibodat qilgan narsaga ibodat qiluvchimasman."
    },
    {
      "ayahNumber": 5,
      "arabic": "وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ",
      "uzbekReading": "Va laa antum 'aabiduuna ma a'bud.",
      "uzbekTranslation": "Va siz ham men ibodat qilganga ibodat qiluvchimassiz."
    },
    {
      "ayahNumber": 6,
      "arabic": "لَكُمْ دِينُكُمْ وَلِيَ دِينِ",
      "uzbekReading": "Lakum diynukum va liya diyn.",
      "uzbekTranslation": "Sizga o'z diningiz, menga o'z dinim."
