  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "قُلْ يَا أَيُّهَا الْكَافِرُونَ",
      "uzbekReading": "Qul yaa-ai yuhal kaafiruun.",
      "uzbekTranslation": "Ayt: «Ey kofirlar!"
    },
    {
      "ayahNumber": 2,
      "arabic": "لَا أَعْبُدُ مَا تَعْبُدُونَ",
      "uzbekReading": "Laa a'budu ma t'abuduun.",
      "uzbekTranslation": "Men siz ibodat qilgan narsalarga ibodat qilmasman."
    },
    {
      "ayahNumber": 3,
      "arabic": "وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ",
      "uzbekReading": "Va laa antum 'aabiduuna maa a'bud.",
      "uzbekTranslation": "Va sizlar ham men ibodat qiladiganga ibodat qiluvchimassiz."
