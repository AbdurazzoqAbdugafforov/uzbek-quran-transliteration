{
  "surahNumber": 108,
  "surahName": "Al-Kawthar",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ",
      "uzbekReading": "Innaa a'taina kal kausar.",
      "russianReading": "Инна а'тайнакал каусар.",
      "uzbekTranslation": "Albatta, Biz senga Kavsarni berdik."
    },
    {
      "ayahNumber": 2,
      "arabic": "فَصَلِّ لِرَبِّكَ وَانْحَرْ",
      "uzbekReading": "Fa salli li Robbika vanhar.",
      "russianReading": "Фасалли лираббика уанхар.",
      "uzbekTranslation": "Bas, Robbingga namoz o'qi va jonlik so'y."
    },
    {
      "ayahNumber": 3,
      "arabic": "إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ",
      "uzbekReading": "Inna shani-aka huval abtar.",
      "russianReading": "Инна шаниака хууал абтар.",
      "uzbekTranslation": "Albatta, seni yomon ko'rib, ayblovchining orqasi kesikdir."
    }
  ]
}
