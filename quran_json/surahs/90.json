{
  "surahNumber": 90,
  "surahName": "Al-Balad",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "لَا أُقْسِمُ بِهَٰذَا الْبَلَدِ",
      "uzbekReading": "Laaa uqsimu bihaazal balad.",
      "russianReading": "Ла уксиму бихазал балад.",
      "uzbekTranslation": "Mana shu shahar bilan qasam."
    },
    {
      "ayahNumber": 2,
      "arabic": "وَأَنْتَ حِلٌّ بِهَٰذَا الْبَلَدِ",
      "uzbekReading": "Va anta hillum bihaazal balad.",
      "russianReading": "Уаанта хиллун бихазал балад.",
      "uzbekTranslation": "Sen muqim turgan bu shaharla."
    },
    {
      "ayahNumber": 3,
      "arabic": "وَوَالِدٍ وَمَا وَلَدَ",
      "uzbekReading": "Va vaalidinv va maa valad.",
      "russianReading": "Уауалидиу уама уалад.",
      "uzbekTranslation": "Va volid va undan tarqagan valadlar bilan qasam."
    },
    {
      "ayahNumber": 4,
      "arabic": "لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي كَبَدٍ",
      "uzbekReading": "Laqad xalaqnal insaana fiy kabad.",
      "russianReading": "Лакад халакнал инсана фии кабад.",
      "uzbekTranslation": "Batahqiq, Biz insonni mashaqqatda yaratdik."
    },
    {
      "ayahNumber": 5,
      "arabic": "أَيَحْسَبُ أَنْ لَنْ يَقْدِرَ عَلَيْهِ أَحَدٌ",
      "uzbekReading": "Ayahsabu al-lai yaqdira 'alaihi ahad.",
      "russianReading": "Айахсабу ал лай йакдира 'алайхи ахад.",
      "uzbekTranslation": "U inson unga hech kimning kuchi yetmaydi, deb hisoblaydimi?"
    },
    {
      "ayahNumber": 6,
      "arabic": "يَقُولُ أَهْلَكْتُ مَالًا لُبَدًا",
      "uzbekReading": "Yaquulu ahlaktu maalal lubadaa.",
      "russianReading": "Йакуулу ахлакту малал лубада.",
      "uzbekTranslation": "U, ko'plab mol-dunyo nafaqa qildim, deydir."
    },
    {
      "ayahNumber": 7,
      "arabic": "أَيَحْسَبُ أَنْ لَمْ يَرَهُ أَحَدٌ",
      "uzbekReading": "Ayahsabu al lam yarahuu ahad.",
      "russianReading": "Айахсабу ал лам йараху ахад.",
      "uzbekTranslation": "U inson uni birov ko'rmadi, deb o'ylaydimi?"
    },
    {
      "ayahNumber": 8,
      "arabic": "أَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِ",
      "uzbekReading": "Alam naj'al lahuu 'aynayn.",
      "russianReading": "Алам наж'аллаху 'айнайн.",
      "uzbekTranslation": "Biz unga ikki ko'zni bermadikmi?"
    },
    {
      "ayahNumber": 9,
      "arabic": "وَلِسَانًا وَشَفَتَيْنِ",
      "uzbekReading": "Va lisaananv va shafatayn.",
      "russianReading": "Уалисанау уашафатайн.",
      "uzbekTranslation": "Va tilni va ikki labni (bermadikmi?)."
    },
    {
      "ayahNumber": 10,
      "arabic": "وَهَدَيْنَاهُ النَّجْدَيْنِ",
      "uzbekReading": "Va hadaynaahun najdayn.",
      "russianReading": "Уахадайнахун наждайн.",
      "uzbekTranslation": "Va Biz uni ikki:."
    },
    {
      "ayahNumber": 11,
      "arabic": "فَلَا اقْتَحَمَ الْعَقَبَةَ",
      "uzbekReading": "Falaq tahamal-'aqabah.",
      "russianReading": "Фала ктахамал 'акаба.",
      "uzbekTranslation": "Bas, u dovon oshib o'tmadi."
    },
    {
      "ayahNumber": 12,
      "arabic": "وَمَا أَدْرَاكَ مَا الْعَقَبَةُ",
      "uzbekReading": "Va maaa adraaka mal'aqabah.",
      "russianReading": "Уама адрака мал 'акаба.",
      "uzbekTranslation": "Dovon qandoq narsa ekanini senga nima bildirdi?"
    },
    {
      "ayahNumber": 13,
      "arabic": "فَكُّ رَقَبَةٍ",
      "uzbekReading": "Fakku raqabah.",
      "russianReading": "Факку ракаба.",
      "uzbekTranslation": "U qul ozod qilishdir."
    },
    {
      "ayahNumber": 14,
      "arabic": "أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ",
      "uzbekReading": "Av it'aamun fiy yavmin ziy masg'abah.",
      "russianReading": "Ау ит'амун фии йаумин зии масгаба.",
      "uzbekTranslation": "Yoki ocharchilik kunida taom berishdir."
    },
    {
      "ayahNumber": 15,
      "arabic": "يَتِيمًا ذَا مَقْرَبَةٍ",
      "uzbekReading": "Yatiyman zaa maqrabah.",
      "russianReading": "Йатииман за макраба.",
      "uzbekTranslation": "Qarindosh yetimlarga."
    },
    {
      "ayahNumber": 16,
      "arabic": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
      "uzbekReading": "Av miskiynan zaa matrabah.",
      "russianReading": "Ау мискиинан за матраба.",
      "uzbekTranslation": "Yoki tuproqqa qorigan miskinlarga."
    },
    {
      "ayahNumber": 17,
      "arabic": "ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ",
      "uzbekReading": "Summa kaana minal laziyna aamanuu va tavaasav bissabri va tavaasav bilmarhamah.",
      "russianReading": "Сумма кана минал лазиина амануу уатауасау биссабри уатауасау билмархама.",
      "uzbekTranslation": "So'ngra iymon keltirganlar va bir-birini sabrga, mehr-shafqatga chaqirganlar bo'lsa."
    },
    {
      "ayahNumber": 18,
      "arabic": "أُولَٰئِكَ أَصْحَابُ الْمَيْمَنَةِ",
      "uzbekReading": "Ulaaa'ika As-haabul maimanah.",
      "russianReading": "Уулаика асхабул маймана.",
      "uzbekTranslation": "Ana o'shalar o'ng tomon egalaridir."
    },
    {
      "ayahNumber": 19,
      "arabic": "وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ",
      "uzbekReading": "Vallaziyna kafaruu bi aayaatinaa hum as-haabul Mash'amah.",
      "russianReading": "Уаллазиина кафаруу биайатина хум асхабул машама.",
      "uzbekTranslation": "Oyatlarimizga kufr keltirganlar, ular, chap tomon egalaridir."
    },
    {
      "ayahNumber": 20,
      "arabic": "عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ",
      "uzbekReading": "Alaihim naarum mu'sadah.",
      "russianReading": "'Алайхим нарум му'сада.",
      "uzbekTranslation": "Ularni chiqib bo'lmaydigan o't-olov o'rab olgandir."
    }
  ]
}
