{
  "surahNumber": 113,
  "surahName": "Al-Falaq",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ",
      "uzbekReading": "Qul a'uzuu bi Robbil-falaq.",
      "uzbekTranslation": "Tong Robbisidan panoh so'rayman."
    },
    {
      "ayahNumber": 2,
      "arabic": "مِنْ شَرِّ مَا خَلَقَ",
      "uzbekReading": "Min sharri ma xalaq.",
      "uzbekTranslation": "U yaratgan narsalar yomonligidan."
    },
    {
      "ayahNumber": 3,
      "arabic": "وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "uzbekReading": "Va min sharri g'asiqin iza vaqab.",
      "uzbekTranslation": "Va kirib kelgan qorong'ulik yomonligidan."
    },
    {
      "ayahNumber": 4,
      "arabic": "وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ",
      "uzbekReading": "Va min sharrin-naffaa-saati fil 'uqad.",
      "uzbekTranslation": "Va tugunlarga dam soluvchilar yomonligidan."
    },
    {
      "ayahNumber": 5,
      "arabic": "وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "uzbekReading": "Va min shar ri haasidin iza hasad.",
      "uzbekTranslation": "Va hasad qilgan hasadchining yomonligidan, deb ayt."
    }
  ]
}