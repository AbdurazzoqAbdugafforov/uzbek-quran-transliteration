{
  "surahNumber": 102,
  "surahName": "At-Takaathur",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "أَلْهَاكُمُ التَّكَاثُرُ",
      "uzbekReading": "Al haaku mut takasur.",
      "russianReading": "Алхакумут такасур.",
      "uzbekTranslation": "Kimniki ko'p sizni mashg'ul qildi."
    },
    {
      "ayahNumber": 2,
      "arabic": "حَتَّىٰ زُرْتُمُ الْمَقَابِرَ",
      "uzbekReading": "Hatta zurtumul-maqaabir.",
      "russianReading": "Хатта зуртумул макабир.",
      "uzbekTranslation": "To qabrlarni ziyorat qilguningizcha."
    },
    {
      "ayahNumber": 3,
      "arabic": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "uzbekReading": "Kalla savfa ta'lamuun.",
      "russianReading": "Калла сауфа та'ламуун.",
      "uzbekTranslation": "Yo'q! Sizlar tezda bilasizlar."
    },
    {
      "ayahNumber": 4,
      "arabic": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "uzbekReading": "Summa kalla savfa ta'lamuun.",
      "russianReading": "Сумма калла сауфа та'ламуун.",
      "uzbekTranslation": "Yana yo'q! Sizlar tezda bilasizlar."
    },
    {
      "ayahNumber": 5,
      "arabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ",
      "uzbekReading": "Kalla law ta'lamuuna 'ilmal yaqiyn.",
      "russianReading": "Калла лау та'ламууна 'илмал йакиин.",
      "uzbekTranslation": "Yo'q! Agar sizlar aniq ilm ila bilganingizda edi."
    },
    {
      "ayahNumber": 6,
      "arabic": "لَتَرَوُنَّ الْجَحِيمَ",
      "uzbekReading": "Latara-vun nal jahiym.",
      "russianReading": "Латараууннал жахиим.",
      "uzbekTranslation": "Albatta, jahannamni ko'rasizlar."
    },
    {
      "ayahNumber": 7,
      "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ",
      "uzbekReading": "Summa latara vunnaha 'ainal yaqiyn.",
      "russianReading": "Сумма латараууннаха 'айнал йакиин.",
      "uzbekTranslation": "Va yana, albatta, uni ishonch ko'zi bilan ko'rasizlar."
    },
    {
      "ayahNumber": 8,
      "arabic": "ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ",
      "uzbekReading": "Summa latus alunna yauma-izin 'anin na'iym.",
      "russianReading": "Сумма латусалунна йаумаизин 'анин на'иим.",
      "uzbekTranslation": "So'ngra o'sha kunda, albatta, berilgan ne'matlardan so'ralasizlar."
    }
  ]
}
