{
  "surahNumber": 104,
  "surahName": "Al-Humaza",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ",
      "uzbekReading": "Vai lul-li kulli hu mazatil-lumaza.",
      "russianReading": "Уайлул ликулли хумазатил лумаза.",
      "uzbekTranslation": "Har bir obro' to'kuvchi va ayblovchiga «vayl» bo'lsin."
    },
    {
      "ayahNumber": 2,
      "arabic": "الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ",
      "uzbekReading": "Al-lazi jama'a maalav va'addadah.",
      "russianReading": "Аллазии жама'а малау уа'аддадах.",
      "uzbekTranslation": "U mol jamladi va uni sanab turdi."
    },
    {
      "ayahNumber": 3,
      "arabic": "يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ",
      "uzbekReading": "Yahsabu anna maalahu axladah.",
      "russianReading": "Йахсабу анна малаху ахладах.",
      "uzbekTranslation": "U, albatta, uni abadiy qoldirur, deb hisoblar."
    },
    {
      "ayahNumber": 4,
      "arabic": "كَلَّا ۖ لَيُنْبَذَنَّ فِي الْحُطَمَةِ",
      "uzbekReading": "Kalla layum ba zanna fil hutamah.",
      "russianReading": "Калла лайунбазанна фиил хутама.",
      "uzbekTranslation": "Yo'q! Albatta u «hutoma»ga xor-zor etib tashlanar."
    },
    {
      "ayahNumber": 5,
      "arabic": "وَمَا أَدْرَاكَ مَا الْحُطَمَةُ",
      "uzbekReading": "Va maa adraaka mal-hutamah.",
      "russianReading": "Уама адрака мал хутама.",
      "uzbekTranslation": "«Hutoma» qandoq narsa ekanini senga nima bildirar?"
    },
    {
      "ayahNumber": 6,
      "arabic": "نَارُ اللَّهِ الْمُوقَدَةُ",
      "uzbekReading": "Narul laahil-muuqada.",
      "russianReading": "Наруллахил муукада.",
      "uzbekTranslation": "U Allohning shiddatli, o'chmas olovidir."
    },
    {
      "ayahNumber": 7,
      "arabic": "الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ",
      "uzbekReading": "Allatiy tat tali'u 'alalafidah.",
      "russianReading": "Аллатии таттали'у 'алал афида.",
      "uzbekTranslation": "Qalbgacha yetib boradir."
    },
    {
      "ayahNumber": 8,
      "arabic": "إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ",
      "uzbekReading": "Innaha 'alaihim muusada.",
      "russianReading": "Иннаха 'алайхим му'сада.",
      "uzbekTranslation": "Albatta, u ularni ustidan qoplangandir."
    },
    {
      "ayahNumber": 9,
      "arabic": "فِي عَمَدٍ مُمَدَّدَةٍ",
      "uzbekReading": "Fiy 'amadim-mumaddadah.",
      "russianReading": "Фии 'амадим мумаддада.",
      "uzbekTranslation": "Uzun-uzun ustunlarga bog'langandirlar."
    }
  ]
}
