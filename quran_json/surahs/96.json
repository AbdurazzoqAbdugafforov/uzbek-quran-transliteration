{
  "surahNumber": 96,
  "surahName": "Al-Alaq",
  "juzNumber": 30,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ",
      "uzbekReading": "Iqra bismi rab bikal laziy xalaq.",
      "russianReading": "Икра' бисми раббикал лазии халак.",
      "uzbekTranslation": "Yaratgan Robbing nomi bilan o'qi."
    },
    {
      "ayahNumber": 2,
      "arabic": "خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ",
      "uzbekReading": "Xalaqal insaana min 'alaq.",
      "russianReading": "Халакал инсана мин 'алак.",
      "uzbekTranslation": "U insonni alaqdan yaratdi."
    },
    {
      "ayahNumber": 3,
      "arabic": "اقْرَأْ وَرَبُّكَ الْأَكْرَمُ",
      "uzbekReading": "Iqra va rab bukal akram.",
      "russianReading": "Икра' уараббукал акрам.",
      "uzbekTranslation": "O'qi! Va Robbing eng karamlidir!"
    },
    {
      "ayahNumber": 4,
      "arabic": "الَّذِي عَلَّمَ بِالْقَلَمِ",
      "uzbekReading": "Al laziy 'allama bil qalam.",
      "russianReading": "Аллазии 'аллама билкалам.",
      "uzbekTranslation": "U qalam bilan ilm o'rgatgandir."
    },
    {
      "ayahNumber": 5,
      "arabic": "عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ",
      "uzbekReading": "'Al lamal insaana ma lam y'alam.",
      "russianReading": "'Алламал инсана ма лам йа'лам.",
      "uzbekTranslation": "U insonga u bilmagan narsani o'rgatdi."
    },
    {
      "ayahNumber": 6,
      "arabic": "كَلَّا إِنَّ الْإِنْسَانَ لَيَطْغَىٰ",
      "uzbekReading": "Kallaa innal insaana layatg'aa.",
      "russianReading": "Калла иннал инсана лайатга.",
      "uzbekTranslation": "Yo'q! Albatta inson tug'yonga ketadir."
    },
    {
      "ayahNumber": 7,
      "arabic": "أَنْ رَآهُ اسْتَغْنَىٰ",
      "uzbekReading": "Ar-ra aahus tag'naa.",
      "russianReading": "Ар рааху стагна.",
      "uzbekTranslation": "O'zini boy ko'rgani uchun."
    },
    {
      "ayahNumber": 8,
      "arabic": "إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ",
      "uzbekReading": "Innna ilaa Robbikar ruj'aa.",
      "russianReading": "Инна ила раббикар руж'а.",
      "uzbekTranslation": "Albatta, qaytib borish Robbingadir."
    },
    {
      "ayahNumber": 9,
      "arabic": "أَرَأَيْتَ الَّذِي يَنْهَىٰ",
      "uzbekReading": "Ara-aital laziy yanhaa.",
      "russianReading": "Араайтал лазии йанха.",
      "uzbekTranslation": "Qaytarganni ko'rdingmi?!"
    },
    {
      "ayahNumber": 10,
      "arabic": "عَبْدًا إِذَا صَلَّىٰ",
      "uzbekReading": "'Abdan iza sallaa.",
      "russianReading": "'Абдан иза салла.",
      "uzbekTranslation": "Bandani namoz o'qiyotganida?!"
    },
    {
      "ayahNumber": 11,
      "arabic": "أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَىٰ",
      "uzbekReading": "Ara-aita in kana 'alal hudaa.",
      "russianReading": "Араайта ин кана 'алал худа.",
      "uzbekTranslation": "Ayt-chi, agar o'sha hidoyatda bo'lsa."
    },
    {
      "ayahNumber": 12,
      "arabic": "أَوْ أَمَرَ بِالتَّقْوَىٰ",
      "uzbekReading": "Au amara bit taqvaa.",
      "russianReading": "Ау амара биттакуа.",
      "uzbekTranslation": "Yoki taqvoga amr qilsa."
    },
    {
      "ayahNumber": 13,
      "arabic": "أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّىٰ",
      "uzbekReading": "Ara-aita in kaz zaba va ta valla.",
      "russianReading": "Араайта ин каззаба уатауалла.",
      "uzbekTranslation": "Ayt-chi, o'sha yolg'onga chiqarsa va yuz o'girsa."
    },
    {
      "ayahNumber": 14,
      "arabic": "أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ",
      "uzbekReading": "Alam y'alam bi-an nal lahaa yaraa.",
      "russianReading": "Алам йа'лам бианналлаха йара.",
      "uzbekTranslation": "Albatta Alloh uni ko'rishini bilmasmi?!"
    },
    {
      "ayahNumber": 15,
      "arabic": "كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ",
      "uzbekReading": "Kalla la illam yantahi la nasfa'am bin nasiyah.",
      "russianReading": "Калла лаил лам йантахи ланасфа'ан биннасийа.",
      "uzbekTranslation": "Yo'q! Agar qaytmasa, peshonasidan shiddatla tutamiz."
    },
    {
      "ayahNumber": 16,
      "arabic": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ",
      "uzbekReading": "Nasiyatin kazi batin xaatiyah.",
      "russianReading": "Насийатин казибатин хатиа.",
      "uzbekTranslation": "Yolg'onchi, xatokor peshonasidan."
    },
    {
      "ayahNumber": 17,
      "arabic": "فَلْيَدْعُ نَادِيَهُ",
      "uzbekReading": "Fal yad'u naadiyah.",
      "russianReading": "Фалйад'у надийах.",
      "uzbekTranslation": "Bas, o'z to'pini chaqirsin."
    },
    {
      "ayahNumber": 18,
      "arabic": "سَنَدْعُ الزَّبَانِيَةَ",
      "uzbekReading": "Sanad 'uz zabaaniyah.",
      "russianReading": "Санад'уз забанийа.",
      "uzbekTranslation": "Biz ham zaboniyalarni chaqiramiz."
    },
    {
      "ayahNumber": 19,
      "arabic": "كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩",
      "uzbekReading": "Kalla; la tuti'hu vasjud vaqtarib.",
      "russianReading": "Калла ла тути'ху уасжуд уактариб.",
      "uzbekTranslation": "Yo'q! Sen unga itoat qilma! Sajda qil va qurbat hosil qil."
    }
  ]
}
