{
  "surahNumber": 56,
  "surahName": "Al-Waaqia",
  "juzNumber": 27,
  "ayahs": [
    {
      "ayahNumber": 1,
      "arabic": "إِذَا وَقَعَتِ الْوَاقِعَةُ",
      "uzbekReading": "Izaa vaqa'atil vaaqi'ah.",
      "russianReading": "Иза уака'атил уаки'а.",
      "uzbekTranslation": "Voqea voqe' bo'lganda."
    },
    {
      "ayahNumber": 2,
      "arabic": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "uzbekReading": "Laisa livaq'atihaa kaazibah.",
      "russianReading": "Лайса лиуак'атиха казиба.",
      "uzbekTranslation": "Uning voqe' bo'lishini yolg'on qiluvchi (jon) yo'qdir."
    },
    {
      "ayahNumber": 3,
      "arabic": "خَافِضَةٌ رَافِعَةٌ",
      "uzbekReading": "Xafidatur raafi'ah.",
      "russianReading": "Хафидатур рафи'а.",
      "uzbekTranslation": "U ham pastlatuvchi, ham ko'taruvchidir."
    },
    {
      "ayahNumber": 4,
      "arabic": "إِذَا رُجَّتِ الْأَرْضُ رَجًّا",
      "uzbekReading": "Izaa rujjatil ardu rajjaa.",
      "russianReading": "Иза ружжатил арду ражжа.",
      "uzbekTranslation": "Qachonki yer qattiq larzaga kelganda."
    },
    {
      "ayahNumber": 5,
      "arabic": "وَبُسَّتِ الْجِبَالُ بَسًّا",
      "uzbekReading": "Va bussatil jibaalu bassaa.",
      "russianReading": "Уабуссатил жибалу басса.",
      "uzbekTranslation": "Tog'lar maydalanib, titilganda."
    },
    {
      "ayahNumber": 6,
      "arabic": "فَكَانَتْ هَبَاءً مُنْبَثًّا",
      "uzbekReading": "Fakaanat habaaa'am mumbassaa.",
      "russianReading": "Факанат хабаам мунбасса.",
      "uzbekTranslation": "Bas, ular tarqalgan chang-to'zonga aylanganda."
    },
    {
      "ayahNumber": 7,
      "arabic": "وَكُنْتُمْ أَزْوَاجًا ثَلَاثَةً",
      "uzbekReading": "Va kuntum azvaajan salaasah.",
      "russianReading": "Уакунтум азуажан саласа.",
      "uzbekTranslation": "Va sizlar uch toifa bo'lgangda."
    },
    {
      "ayahNumber": 8,
      "arabic": "فَأَصْحَابُ الْمَيْمَنَةِ مَا أَصْحَابُ الْمَيْمَنَةِ",
      "uzbekReading": "Fa as haabul maimanati maaa as haabul maimanah.",
      "russianReading": "Фаасхабул майманати ма асхабул маймана.",
      "uzbekTranslation": "O'ng taraf egalari. O'ng taraf egalari ne(saodatlilar)dir?!"
    },
    {
      "ayahNumber": 9,
      "arabic": "وَأَصْحَابُ الْمَشْأَمَةِ مَا أَصْحَابُ الْمَشْأَمَةِ",
      "uzbekReading": "Va as haabul mash'amati maaa as haabul mash'amah.",
      "russianReading": "Уаасхабул машамати ма асхабул машама.",
      "uzbekTranslation": "Va chap taraf egalari. Chap taraf egalari ne(badbaxtlar)dir?!"
    },
    {
      "ayahNumber": 10,
      "arabic": "وَالسَّابِقُونَ السَّابِقُونَ",
      "uzbekReading": "Vassaabiquunas saabiquun.",
      "russianReading": "Уассабикуунас сабикуун.",
      "uzbekTranslation": "Va peshqadamlar, peshqadamlar."
    },
    {
      "ayahNumber": 11,
      "arabic": "أُولَٰئِكَ الْمُقَرَّبُونَ",
      "uzbekReading": "Ulaaa'ikal muqarrabuun.",
      "russianReading": "Уулаикал мукаррабуун.",
      "uzbekTranslation": "Ana o'shalar, (Allohga) yaqin bo'lganlar."
    },
    {
      "ayahNumber": 12,
      "arabic": "فِي جَنَّاتِ النَّعِيمِ",
      "uzbekReading": "Fiy Jannaatin Na'iym.",
      "russianReading": "Фии жаннатин на'иим.",
      "uzbekTranslation": "Serne'mat jannatlardalar."
    },
    {
      "ayahNumber": 13,
      "arabic": "ثُلَّةٌ مِنَ الْأَوَّلِينَ",
      "uzbekReading": "Sullatum minal avvaliyn.",
      "russianReading": "Суллатум минал аууалиин.",
      "uzbekTranslation": "Avvalgilardan ko'pgina jamoatlar."
    },
    {
      "ayahNumber": 14,
      "arabic": "وَقَلِيلٌ مِنَ الْآخِرِينَ",
      "uzbekReading": "Va qaliylum minal aa xiriyn.",
      "russianReading": "Уакалиилум минал ахириин.",
      "uzbekTranslation": "Va oxirgilardan ozdirlar."
    },
    {
      "ayahNumber": 15,
      "arabic": "عَلَىٰ سُرُرٍ مَوْضُونَةٍ",
      "uzbekReading": "'Alaa sururim mavduunah.",
      "russianReading": "'Ала сурурим маудууна.",
      "uzbekTranslation": "To'qima so'rilaridalar."
    },
    {
      "ayahNumber": 16,
      "arabic": "مُتَّكِئِينَ عَلَيْهَا مُتَقَابِلِينَ",
      "uzbekReading": "Muttaki'iyna 'alaihaa mutaqabiliyn.",
      "russianReading": "Муттакиина 'алайха мутакабилиин.",
      "uzbekTranslation": "Bir-birlariga ro'baro' bo'lib, yonboshlagan hollaridalar."
    },
    {
      "ayahNumber": 17,
      "arabic": "يَطُوفُ عَلَيْهِمْ وِلْدَانٌ مُخَلَّدُونَ",
      "uzbekReading": "Yatuufu 'alaihim vildaa num mukxalladuun.",
      "russianReading": "Йатууфу 'алайхим уилданум мухалладуун.",
      "uzbekTranslation": "Atroflarida mangu yosh yigitlar aylanib yururlar."
    },
    {
      "ayahNumber": 18,
      "arabic": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِنْ مَعِينٍ",
      "uzbekReading": "Bi akvaabinv va abaariyq, va kaasim mim ma'iyn.",
      "russianReading": "Биакуабиу уаабариика уака'сим мим ма'иин.",
      "uzbekTranslation": "Oqar chashma."
    },
    {
      "ayahNumber": 19,
      "arabic": "لَا يُصَدَّعُونَ عَنْهَا وَلَا يُنْزِفُونَ",
      "uzbekReading": "Laa yusadda'uuna 'anhaa va laa yunzifuun.",
      "russianReading": "Ла йусадда'ууна 'анха уала йунзифуун.",
      "uzbekTranslation": "Undan bosh og'rig'i ham, mast ham bo'lmaslar."
    },
    {
      "ayahNumber": 20,
      "arabic": "وَفَاكِهَةٍ مِمَّا يَتَخَيَّرُونَ",
      "uzbekReading": "Va faakihatim mimmaa yataxaiyaruun.",
      "russianReading": "Уафакихатим мимма йатахаййаруун.",
      "uzbekTranslation": "Va ular xohlagan mevalar bilan."
    },
    {
      "ayahNumber": 21,
      "arabic": "وَلَحْمِ طَيْرٍ مِمَّا يَشْتَهُونَ",
      "uzbekReading": "Va lahmi tairim mimmaa yashtahuun.",
      "russianReading": "Уалахми тайрим мимма йаштахуун.",
      "uzbekTranslation": "Ishtahalari tusagan qush go'shti bilan."
    },
    {
      "ayahNumber": 22,
      "arabic": "وَحُورٌ عِينٌ",
      "uzbekReading": "Va huurun'iyn.",
      "russianReading": "Уахуурун 'иин.",
      "uzbekTranslation": "Yana ko'zi go'zal hurlar bor."
    },
    {
      "ayahNumber": 23,
      "arabic": "كَأَمْثَالِ اللُّؤْلُؤِ الْمَكْنُونِ",
      "uzbekReading": "Ka amsaalil lu'lu'il maknuun.",
      "russianReading": "Каамсалил лу'луил макнуун.",
      "uzbekTranslation": "Misoli yashirilgan dur."
    },
    {
      "ayahNumber": 24,
      "arabic": "جَزَاءً بِمَا كَانُوا يَعْمَلُونَ",
      "uzbekReading": "Jazaaa'am bimaa kaanuu ya'maluun.",
      "russianReading": "Жазаан бима кануу йа'малуун.",
      "uzbekTranslation": "Bular, qilgan amallarning mukofotidur."
    },
    {
      "ayahNumber": 25,
      "arabic": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
      "uzbekReading": "Laa yasma'uuna fiyhaa lag'vanv va laa taasiymaa.",
      "russianReading": "Ла йасма'ууна фииха лагуау уала та'сиима.",
      "uzbekTranslation": "Ular u yerda behuda, gunoh so'zlarni eshitmaslar."
    },
    {
      "ayahNumber": 26,
      "arabic": "إِلَّا قِيلًا سَلَامًا سَلَامًا",
      "uzbekReading": "Illaa qiylan salaaman salaamaa.",
      "russianReading": "Илла киилан саламан салама.",
      "uzbekTranslation": "Faqat «Salom, Salom» deyilganini."
    },
    {
      "ayahNumber": 27,
      "arabic": "وَأَصْحَابُ الْيَمِينِ مَا أَصْحَابُ الْيَمِينِ",
      "uzbekReading": "Va as haabul yamiyni maaa as haabul Yamiyn.",
      "russianReading": "Уаасхабул йамиини ма асхабул йамиин.",
      "uzbekTranslation": "O'ng taraf egalari. O'ng taraf egalari ne(saodatlilar)dir!"
    },
    {
      "ayahNumber": 28,
      "arabic": "فِي سِدْرٍ مَخْضُودٍ",
      "uzbekReading": "Fiy sidrim maxduud.",
      "russianReading": "Фии сидрим махдууд.",
      "uzbekTranslation": "Ular tikonsiz sidrzorlardadir."
    },
    {
      "ayahNumber": 29,
      "arabic": "وَطَلْحٍ مَنْضُودٍ",
      "uzbekReading": "Va talhim manduud.",
      "russianReading": "Уаталхим мандууд.",
      "uzbekTranslation": "Sermeva bananzorlardadir."
    },
    {
      "ayahNumber": 30,
      "arabic": "وَظِلٍّ مَمْدُودٍ",
      "uzbekReading": "Va zillim mamduud.",
      "russianReading": "Уазиллим мамдууд.",
      "uzbekTranslation": "Va yoyilgan soyalardadir."
    },
    {
      "ayahNumber": 31,
      "arabic": "وَمَاءٍ مَسْكُوبٍ",
      "uzbekReading": "Va maaa'im maskuub.",
      "russianReading": "Уамаим маскууб.",
      "uzbekTranslation": "Oqar suvlardadir."
    },
    {
      "ayahNumber": 32,
      "arabic": "وَفَاكِهَةٍ كَثِيرَةٍ",
      "uzbekReading": "Va faakihatin kasiyrah.",
      "russianReading": "Уафакихатин касиира.",
      "uzbekTranslation": "Serob mevalardadir."
    },
    {
      "ayahNumber": 33,
      "arabic": "لَا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
      "uzbekReading": "Laa maqtuu'atinv va laa mamnuu'ah.",
      "russianReading": "Ла мактуу'атиу уала мамнуу'а.",
      "uzbekTranslation": "Tugamaydigan va man qilinmaydiganlardadir."
    },
    {
      "ayahNumber": 34,
      "arabic": "وَفُرُشٍ مَرْفُوعَةٍ",
      "uzbekReading": "Va furushim marfuu'ah.",
      "russianReading": "Уафурушим марфуу'а.",
      "uzbekTranslation": "Baland-baland ko'rpachalardadir."
    },
    {
      "ayahNumber": 35,
      "arabic": "إِنَّا أَنْشَأْنَاهُنَّ إِنْشَاءً",
      "uzbekReading": "Innaaa anshaanaahunna inshaaa'aa.",
      "russianReading": "Инна анша'нахунна иншаа.",
      "uzbekTranslation": "Albatta, Biz u."
    },
    {
      "ayahNumber": 36,
      "arabic": "فَجَعَلْنَاهُنَّ أَبْكَارًا",
      "uzbekReading": "Faja'alnaahunna abkaaraa.",
      "russianReading": "Фажа'алнахунна абкара.",
      "uzbekTranslation": "Bas, ularni bokiralar qildik."
    },
    {
      "ayahNumber": 37,
      "arabic": "عُرُبًا أَتْرَابًا",
      "uzbekReading": "'Uruban atraabaa.",
      "russianReading": "'Урубан атраба.",
      "uzbekTranslation": "Tengdosh mahbubalar qildik."
    },
    {
      "ayahNumber": 38,
      "arabic": "لِأَصْحَابِ الْيَمِينِ",
      "uzbekReading": "Li as haabil yamiyn.",
      "russianReading": "Лиасхабил йамиин.",
      "uzbekTranslation": "O'ng taraf egalari uchun."
    },
    {
      "ayahNumber": 39,
      "arabic": "ثُلَّةٌ مِنَ الْأَوَّلِينَ",
      "uzbekReading": "Sullatum minal avva liyn.",
      "russianReading": "Суллатум минал аууалиин.",
      "uzbekTranslation": "Ular avvalgilardan ko'pgina jamoatlardir."
    },
    {
      "ayahNumber": 40,
      "arabic": "وَثُلَّةٌ مِنَ الْآخِرِينَ",
      "uzbekReading": "Va sullatum minal aaxiriyn.",
      "russianReading": "Уасуллатум минал ахириин.",
      "uzbekTranslation": "Keyingilardan ham ko'pgina jamoatlardir."
    },
    {
      "ayahNumber": 41,
      "arabic": "وَأَصْحَابُ الشِّمَالِ مَا أَصْحَابُ الشِّمَالِ",
      "uzbekReading": "Va as haabush shimaali maaa as haabush shimaal.",
      "russianReading": "Уаасхабуш шимали ма асхабуш шимал.",
      "uzbekTranslation": "Va chap taraf egalari. Chap taraf egalari ne(badbaxtlar)dir?!"
    },
    {
      "ayahNumber": 42,
      "arabic": "فِي سَمُومٍ وَحَمِيمٍ",
      "uzbekReading": "Fiy samuuminv va hamiym.",
      "russianReading": "Фии самуумиу уахамиим.",
      "uzbekTranslation": "Ular o't shamol va qaynoq suvdadirlar."
    },
    {
      "ayahNumber": 43,
      "arabic": "وَظِلٍّ مِنْ يَحْمُومٍ",
      "uzbekReading": "Va zillim miny yahmuum.",
      "russianReading": "Уазиллим мий йахмуум.",
      "uzbekTranslation": "Qop-qora tutundan bo'lgan soyadadirlar."
    },
    {
      "ayahNumber": 44,
      "arabic": "لَا بَارِدٍ وَلَا كَرِيمٍ",
      "uzbekReading": "Laa baaridinv va laa kariym.",
      "russianReading": "Ла баридиу уала кариим.",
      "uzbekTranslation": "Salqin hamemas, foydaii ham."
    },
    {
      "ayahNumber": 45,
      "arabic": "إِنَّهُمْ كَانُوا قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "uzbekReading": "Innaahum kaanuu qabla zaalika mutrafiyn.",
      "russianReading": "Иннахум кануу кабла залика мутрафиин.",
      "uzbekTranslation": "Albatta ular bundan oldin hoy-havasga berilganlardan edilar."
    },
    {
      "ayahNumber": 46,
      "arabic": "وَكَانُوا يُصِرُّونَ عَلَى الْحِنْثِ الْعَظِيمِ",
      "uzbekReading": "Va kaanuu yusirruuna 'alal hinsil 'aziym.",
      "russianReading": "Уакануу йусиррууна 'алал хинсил 'азиим.",
      "uzbekTranslation": "Va mudom katta gunoh ishlar qilar edilar."
    },
    {
      "ayahNumber": 47,
      "arabic": "وَكَانُوا يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ",
      "uzbekReading": "Va kaanuu yaquuluuna a'izaa mitnaa va kunnaa turaabanv va izaaman'ainnaa lamab'uusuun.",
      "russianReading": "Уакануу йакуулууна аиза митна уакунна турабау уа'изаман аинна ламаб'уусуун.",
      "uzbekTranslation": "Va «Biz o'lib, tuproqqa va suyakka aylanganimizdan keyin qayta tiriltrilamizmi?"
    },
    {
      "ayahNumber": 48,
      "arabic": "أَوَآبَاؤُنَا الْأَوَّلُونَ",
      "uzbekReading": "Ava aabaaa'unal avvaluun.",
      "russianReading": "Ауаабаунал аууалуун.",
      "uzbekTranslation": "Avvalgi otalarimiz ham-a?!» der edilar."
    },
    {
      "ayahNumber": 49,
      "arabic": "قُلْ إِنَّ الْأَوَّلِينَ وَالْآخِرِينَ",
      "uzbekReading": "Qul innal avvaliyna val aaxiriyn.",
      "russianReading": "Кул иннал аууалиина уалахириин.",
      "uzbekTranslation": "Aytgil: «Albatta, avvalgilar va oxirgilar."
    },
    {
      "ayahNumber": 50,
      "arabic": "لَمَجْمُوعُونَ إِلَىٰ مِيقَاتِ يَوْمٍ مَعْلُومٍ",
      "uzbekReading": "Lamajmuu'uuna ilaa miyqaati yavmim ma'luum.",
      "russianReading": "Ламажмуу'ууна ила миикати йаумим ма'луум.",
      "uzbekTranslation": "Ma'lum kunga belgilangan vaqtda albatta to'planuvchilar»."
    },
    {
      "ayahNumber": 51,
      "arabic": "ثُمَّ إِنَّكُمْ أَيُّهَا الضَّالُّونَ الْمُكَذِّبُونَ",
      "uzbekReading": "Summa innakum ayyuhad daaalluunal mukazzibuun.",
      "russianReading": "Сумма иннакум аййухад даллуунал муказзибуун.",
      "uzbekTranslation": "So'ngra, siz ey adashganlar, yolg'onga chiqaruvchilar!"
    },
    {
      "ayahNumber": 52,
      "arabic": "لَآكِلُونَ مِنْ شَجَرٍ مِنْ زَقُّومٍ",
      "uzbekReading": "La aakiluuna min shaja rim min zaqquum.",
      "russianReading": "Лаакилууна мин шажарим мин заккуум.",
      "uzbekTranslation": "Albatta, zaqqum daraxtidan yeyuvchisizlar."
    },
    {
      "ayahNumber": 53,
      "arabic": "فَمَالِئُونَ مِنْهَا الْبُطُونَ",
      "uzbekReading": "Famaali'uuna minhal butuun.",
      "russianReading": "Фамалиууна минхал бутуун.",
      "uzbekTranslation": "Bas, undan qorinlarni to'ldiruvchisizlar."
    },
    {
      "ayahNumber": 54,
      "arabic": "فَشَارِبُونَ عَلَيْهِ مِنَ الْحَمِيمِ",
      "uzbekReading": "Fashaaribuuna 'alaihi minal hamiym.",
      "russianReading": "Фашарибууна 'алайхи минал хамиим.",
      "uzbekTranslation": "Bas, ustidan o'ta qaynoq suvdan ichuvchisizlar."
    },
    {
      "ayahNumber": 55,
      "arabic": "فَشَارِبُونَ شُرْبَ الْهِيمِ",
      "uzbekReading": "Fashaaribuuna shurbal hiym.",
      "russianReading": "Фашарибууна шурбал хиим.",
      "uzbekTranslation": "Bas, chanqoq tuyadek ichuvchisizlar."
    },
    {
      "ayahNumber": 56,
      "arabic": "هَٰذَا نُزُلُهُمْ يَوْمَ الدِّينِ",
      "uzbekReading": "Haazaa nuzuluhum yavmad diyn.",
      "russianReading": "Хаза нузулухум йаумад диин.",
      "uzbekTranslation": "Ularning qiyomat kunidagi ziyofatlari mana shu!"
    },
    {
      "ayahNumber": 57,
      "arabic": "نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "uzbekReading": "Nahnu xalaqnaakum falav laa tusaddiquun.",
      "russianReading": "Нахну халакнакум фалаула тусаддикуун.",
      "uzbekTranslation": "Biz sizlarni yaratganimiz, ishonsalaring-chi!"
    },
    {
      "ayahNumber": 58,
      "arabic": "أَفَرَأَيْتُمْ مَا تُمْنُونَ",
      "uzbekReading": "Afara'aytum maa tumnuun.",
